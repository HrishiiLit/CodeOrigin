# ==========================================
# CodeOrigin AI — Environment Configuration
# ==========================================

# Application Environment (development, testing, production)
APP_ENV=development

# FastAPI Backend Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=codeorigin_ai

# File Upload & Storage Policy
# For Windows local dev, e.g., ./storage/uploads or absolute path
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
# Supported extensions: single Python files, ZIP or TAR archives
ALLOWED_EXTENSIONS=.py,.zip,.tar.gz,.tgz,.tar

# Analysis Pipeline Timeouts & Limits
ANALYSIS_TIMEOUT_SECONDS=20

# GitHub Integration — used for repository ingestion (Phase 2) and issue creation (Phase 7)
# Generate a Personal Access Token with read-only repo scope
GITHUB_TOKEN=
GITHUB_DEFAULT_REPOSITORY=
